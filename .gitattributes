# Normalize line endings: LF in the repository and in working copies on every
# operating system, so generated code and scripts are identical everywhere.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files.
*.pdf binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated files: collapsed in diffs and excluded from language statistics.
*.gen.go linguist-generated=true
*.pb.go linguist-generated=true
*.connect.go linguist-generated=true
web/src/api/schema.gen.ts linguist-generated=true
web/pnpm-lock.yaml linguist-generated=true
hack/tools/go.sum linguist-generated=true
go.sum linguist-generated=true

# Signed test vectors: their bytes are signed, so they are never converted.
test/conformance/vectors/bundles/** -text
