{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "White Tower decision request",
  "description": "An OpenID AuthZEN Authorization API 1.0 evaluation request, restricted by the White Tower decision profile v1alpha1 (docs/contracts/module-contract-v0.1.md, section 6).",
  "type": "object",
  "required": ["subject", "action", "resource", "context"],
  "additionalProperties": false,
  "properties": {
    "subject": {
      "description": "The agent making the request.",
      "type": "object",
      "required": ["type", "id", "properties"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "agent" },
        "id": { "$ref": "#/$defs/uuid" },
        "properties": {
          "type": "object",
          "required": ["slug", "kind", "risk_tier", "environment", "data_categories", "owner", "labels"],
          "additionalProperties": false,
          "properties": {
            "slug": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" },
            "kind": { "enum": ["in_house", "third_party"] },
            "risk_tier": { "enum": ["low", "medium", "high", "critical"] },
            "environment": {
              "description": "The environment the core returned at registration, recorded for the credential the enforcement point runs with (I-7).",
              "enum": ["production", "non_production"]
            },
            "data_categories": {
              "description": "At most 32, of at most 63 characters each: the inventory's limits, so the subject built from the state always matches this schema (CORE-17).",
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "minLength": 1, "maxLength": 63 },
              "uniqueItems": true
            },
            "owner": { "$ref": "#/$defs/uuid" },
            "labels": {
              "description": "At most 64, with values of at most 255 characters: the inventory's limits, so the subject built from the state always matches this schema (CORE-17).",
              "type": "object",
              "maxProperties": 64,
              "propertyNames": { "pattern": "^[a-z0-9]([a-z0-9._/-]{0,61}[a-z0-9])?$" },
              "additionalProperties": { "type": "string", "maxLength": 255 }
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "agent.start",
            "input.receive",
            "tool.expose",
            "model.invoke",
            "model.result",
            "tool.invoke",
            "tool.result",
            "output.emit",
            "agent.stop"
          ]
        }
      }
    },
    "resource": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["agent", "tool", "model", "mcp_server", "dataset", "skill", "url"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "properties": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "tool" } } },
          "then": {
            "required": ["properties"],
            "properties": {
              "properties": {
                "description": "From the catalog, never from the agent, and all required (section 6.3): an MCP tool also has its server and its transport, and a built-in tool its provider, and no tool has those of another kind, as in the catalog file. The bounds are the catalog file's, so that every entry that step V7 accepts makes a request inside the profile.",
                "type": "object",
                "required": ["kind", "origin", "name", "read_only", "destructive", "open_world"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "enum": ["function", "mcp", "builtin", "http", "other"] },
                  "origin": { "enum": ["agent", "provider"] },
                  "name": { "type": "string", "minLength": 1 },
                  "read_only": { "type": "boolean" },
                  "destructive": { "type": "boolean" },
                  "open_world": { "type": "boolean" },
                  "server": { "description": "The key of the MCP server that provides the tool.", "type": "string", "pattern": "^[a-z0-9-]{1,63}$" },
                  "transport": { "enum": ["stdio", "http"] },
                  "provider": { "description": "The model provider that defines a built-in tool.", "type": "string", "minLength": 1 }
                },
                "allOf": [
                  {
                    "if": { "properties": { "kind": { "const": "mcp" } } },
                    "then": { "required": ["server", "transport"] },
                    "else": { "not": { "anyOf": [{ "required": ["server"] }, { "required": ["transport"] }] } }
                  },
                  {
                    "if": { "properties": { "kind": { "const": "builtin" } } },
                    "then": { "required": ["provider"] },
                    "else": { "not": { "required": ["provider"] } }
                  }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "model" } } },
          "then": {
            "required": ["properties"],
            "properties": {
              "properties": {
                "description": "From the catalog, and all required (section 6.3), with the catalog file's bounds.",
                "type": "object",
                "required": ["provider", "name", "endpoint"],
                "additionalProperties": false,
                "properties": {
                  "provider": { "type": "string", "minLength": 1 },
                  "name": { "type": "string", "minLength": 1 },
                  "endpoint": { "description": "The normalized base URL of the endpoint the agent calls (section 4.10).", "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["agent", "mcp_server", "dataset", "skill", "url"] } } },
          "then": { "properties": { "properties": { "type": "object", "maxProperties": 0 } } }
        }
      ]
    },
    "context": {
      "type": "object",
      "required": ["time"],
      "additionalProperties": false,
      "properties": {
        "time": { "$ref": "#/$defs/timestamp" },
        "task_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "on_behalf_of": {
          "description": "Reserved for per-task delegated credentials (Phase 2). Never present in v1alpha1: a request that carries it, even empty, is invalid (section 6.4).",
          "not": {}
        },
        "args": {
          "description": "tool.invoke and tool.result only, and required there: exactly one record, the resource's own, keyed by the tool's key, with the arguments that its catalog entry declares (sections 6.4 and 6.11). That the record is the resource's own, which no schema can express, is a rule of the profile.",
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/toolRecord" }
        },
        "calls_decided": {
          "description": "tool.expose only, and required there: whether every call of the tool will be decided as tool.invoke before it runs (section 6.10).",
          "type": "boolean"
        },
        "digest": {
          "description": "model.invoke only: the digest of the model's weights, when the runtime reports one (section 6.9).",
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "properties": { "name": { "enum": ["agent.start", "input.receive", "output.emit", "agent.stop"] } } } } },
      "then": { "properties": { "resource": { "properties": { "type": { "const": "agent" } } } } }
    },
    {
      "if": { "properties": { "action": { "properties": { "name": { "enum": ["model.invoke", "model.result"] } } } } },
      "then": { "properties": { "resource": { "properties": { "type": { "const": "model" } } } } }
    },
    {
      "if": { "properties": { "action": { "properties": { "name": { "enum": ["tool.expose", "tool.invoke", "tool.result"] } } } } },
      "then": { "properties": { "resource": { "properties": { "type": { "const": "tool" } } } } }
    },
    {
      "if": { "properties": { "action": { "properties": { "name": { "enum": ["tool.invoke", "tool.result"] } } } } },
      "then": { "properties": { "context": { "required": ["args"] } } },
      "else": { "properties": { "context": { "not": { "required": ["args"] } } } }
    },
    {
      "if": { "properties": { "action": { "properties": { "name": { "const": "tool.expose" } } } } },
      "then": { "properties": { "context": { "required": ["calls_decided"] } } },
      "else": { "properties": { "context": { "not": { "required": ["calls_decided"] } } } }
    },
    {
      "if": { "properties": { "action": { "properties": { "name": { "const": "model.invoke" } } } } },
      "else": { "properties": { "context": { "not": { "required": ["digest"] } } } }
    }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "timestamp": {
      "description": "RFC 3339, UTC, with milliseconds (NFR-19).",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "toolRecord": {
      "description": "A tool's record: each declared argument, under its name, which is its path, the property names joined by ., followed by : and its transform when it has one (section 7.7). Its value is a string, a boolean, an integer, or an array of strings or of integers, which Cedar reads as a set; never null or an object (section 6.4).",
      "type": "object",
      "propertyNames": { "pattern": "^[^.:]*(\\.[^.:]*)*(:(lowercase|path|url_host|email_domain))?$" },
      "additionalProperties": {
        "anyOf": [
          { "type": ["string", "boolean", "integer"] },
          { "type": "array", "items": { "type": "string" } },
          { "type": "array", "items": { "type": "integer" } }
        ]
      }
    }
  }
}
