{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "White Tower policy bundle manifest",
  "description": "The signed manifest of a policy bundle, format whitetower.bundle.v1 (docs/contracts/module-contract-v0.1.md, section 7). The signed bytes are the RFC 8785 canonical JSON of this document.",
  "type": "object",
  "required": ["format", "agent_id", "version", "created_at", "combining_algorithm", "language", "policies"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "whitetower.bundle.v1" },
    "agent_id": { "$ref": "#/$defs/uuid" },
    "version": { "description": "Monotonic per agent.", "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "combining_algorithm": { "const": "wt-deny-overrides-v1" },
    "language": { "enum": ["cedar", "rego"] },
    "cedar_schema": {
      "description": "The Cedar schema the policies were validated against: the profile's schema with the deployment's ToolArgs.",
      "$ref": "#/$defs/file"
    },
    "policies": {
      "description": "Global and agent-specific policies, in no particular order.",
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "scope", "path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "version": { "type": "integer", "minimum": 1 },
          "scope": { "enum": ["global", "agent"] },
          "path": { "type": "string", "pattern": "^policies/(global|agent)/[0-9a-f-]{36}\\.(cedar|rego)$" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "language": { "const": "rego" } } },
      "then": { "not": { "required": ["cedar_schema"] } }
    }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "const": "schema.cedarschema" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
