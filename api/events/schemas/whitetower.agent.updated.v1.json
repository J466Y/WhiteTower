{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent updated",
  "description": "An agent's metadata changed (INV-01; plan P1-04, step 2). The description and the harness are free text that people write: they are named as changed, never copied. Enforcement points see four of the members: the risk tier, which also sets the lease, the data categories, the labels and the halt mode. The event carries its governance state version when it changed one of them, and only then.",
  "type": "object",
  "required": [
    "changed",
    "actor"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "changed"
        ],
        "properties": {
          "changed": {
            "contains": {
              "enum": [
                "risk_tier",
                "data_categories",
                "labels",
                "halt_mode"
              ]
            }
          }
        }
      },
      "then": {
        "required": [
          "state_version"
        ]
      },
      "else": {
        "not": {
          "required": [
            "state_version"
          ]
        }
      }
    }
  ],
  "properties": {
    "changed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "name",
          "description",
          "vendor",
          "framework",
          "deployment_location",
          "environments",
          "risk_tier",
          "ai_act_classification",
          "data_categories",
          "use_case_id",
          "labels",
          "harness",
          "halt_mode",
          "drill_eligible"
        ]
      }
    },
    "before": {
      "$ref": "#/$defs/values"
    },
    "after": {
      "$ref": "#/$defs/values"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "state_version": {
      "$ref": "common.schema.json#/$defs/stateVersion"
    }
  },
  "$defs": {
    "values": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "deployment_location": {
          "type": "string"
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_tier": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "ai_act_classification": {
          "enum": [
            "prohibited",
            "high_risk",
            "limited",
            "minimal",
            "not_assessed"
          ]
        },
        "data_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "use_case_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "halt_mode": {
          "enum": [
            "block",
            "interrupt",
            "terminate"
          ]
        },
        "drill_eligible": {
          "type": "boolean"
        }
      }
    }
  }
}
