{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quarantine applied",
  "description": "A network quarantine rule is in place for the agent (KIL-10).",
  "type": "object",
  "required": [
    "halt_ids",
    "workloads",
    "rule",
    "cluster",
    "cni"
  ],
  "additionalProperties": false,
  "properties": {
    "halt_ids": {
      "description": "The halts that cover the agent.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      }
    },
    "workloads": {
      "type": "integer",
      "minimum": 0
    },
    "rule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "cluster": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "cni": {
      "enum": [
        "cilium",
        "calico",
        "antrea",
        "admin-network-policy"
      ]
    }
  }
}
