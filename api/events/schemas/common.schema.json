{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Definitions shared by the event schemas",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "stateVersion": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "enum": [
        "agent.start",
        "input.receive",
        "tool.expose",
        "model.invoke",
        "model.result",
        "tool.invoke",
        "tool.result",
        "output.emit",
        "agent.stop"
      ]
    },
    "resourceType": {
      "enum": [
        "agent",
        "tool",
        "model",
        "mcp_server",
        "dataset",
        "skill",
        "url"
      ]
    },
    "resource": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/resourceType"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "decisionReason": {
      "enum": [
        "policy.permit",
        "policy.forbid",
        "policy.no_permit",
        "gate.no_state",
        "gate.lease_expired",
        "gate.halted",
        "gate.fleet_halted",
        "gate.lifecycle",
        "gate.no_bundle",
        "gate.evidence_full",
        "catalog.blocked",
        "catalog.unknown",
        "catalog.not_approved",
        "catalog.not_enabled",
        "catalog.definition_changed",
        "catalog.digest_mismatch",
        "error.evaluation",
        "error.timeout",
        "error.unknown_agent",
        "error.invalid_request"
      ]
    },
    "origin": {
      "description": "Who runs a tool (section 4.10): the agent's process, or an MCP server that the agent connects to (agent), or the model provider, during a model call (provider).",
      "enum": [
        "agent",
        "provider"
      ]
    },
    "bundleRejection": {
      "enum": [
        "oversized",
        "unknown_key",
        "signature",
        "manifest_mismatch",
        "invalid_manifest",
        "unsupported",
        "missing_file",
        "file_hash",
        "extra_file",
        "older_version",
        "parse_error"
      ]
    },
    "lifecycleState": {
      "enum": [
        "draft",
        "proposed",
        "validated",
        "ready",
        "active",
        "suspended",
        "retired",
        "rejected"
      ]
    },
    "haltScope": {
      "enum": [
        "agent",
        "selector",
        "fleet"
      ]
    },
    "haltMode": {
      "enum": [
        "block",
        "interrupt",
        "terminate"
      ]
    },
    "haltLayerReport": {
      "type": "object",
      "required": [
        "layer",
        "outcome",
        "after_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "layer": {
          "enum": [
            "gate_closed",
            "in_flight_interrupted",
            "process_terminated",
            "network_quarantined"
          ]
        },
        "outcome": {
          "enum": [
            "done",
            "not_done",
            "not_applicable",
            "failed"
          ]
        },
        "after_ms": {
          "description": "Milliseconds to the outcome, on the monotonic clock of the process that reports. In instance.halted, from the moment that process received the halt, or, for a halt it found at start, since it applied the state that carried the halt (section 5.5). In lease.expired, from the moment the lease ran out (section 5.3).",
          "type": "integer",
          "minimum": 0
        },
        "detail": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "quarantineMechanism": {
      "description": "What enforces a network quarantine (section 5.8): an open value, a lowercase name of letters, digits and dashes, of at most 63 characters, in the form of a slug. The known values are the deny rules of the CNIs that ASM-05 names: cilium, calico, antrea, and admin-network-policy for a CNI that implements AdminNetworkPolicy. Another mechanism names itself the same way.",
      "examples": [
        "cilium",
        "calico",
        "antrea",
        "admin-network-policy"
      ],
      "$ref": "#/$defs/slug"
    },
    "actor": {
      "description": "Who did it, by pseudonymous principal ID. Never a name or an email address.",
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "human",
            "service_account",
            "breakglass",
            "system"
          ]
        },
        "id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "system"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "id"
          ]
        }
      },
      "else": {
        "required": [
          "id"
        ]
      }
    },
    "selector": {
      "description": "The agents a selector halt covers, in every environment: every condition must hold.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "risk_tiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        },
        "labels": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
