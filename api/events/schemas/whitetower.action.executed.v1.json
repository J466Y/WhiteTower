{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Action executed",
  "description": "The outcome of an allowed call.",
  "type": "object",
  "required": [
    "decision_id",
    "action",
    "resource",
    "outcome",
    "duration_ms"
  ],
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "description": "The id of the decision.made event that allowed the call.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "action": {
      "$ref": "common.schema.json#/$defs/action"
    },
    "resource": {
      "$ref": "common.schema.json#/$defs/resource"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "error_type": {
      "description": "The error's type or code, never its message, which may hold personal data.",
      "type": "string",
      "maxLength": 200
    }
  }
}
