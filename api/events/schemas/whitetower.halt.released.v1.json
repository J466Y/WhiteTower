{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Halt released",
  "description": "The release of a halt (KIL-05). The agent of an agent halt stays suspended until reinstated.",
  "type": "object",
  "required": [
    "halt_id",
    "scope",
    "requested_by",
    "approved_by",
    "reason",
    "state_version"
  ],
  "additionalProperties": false,
  "properties": {
    "halt_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "scope": {
      "$ref": "common.schema.json#/$defs/haltScope"
    },
    "requested_by": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "approved_by": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "state_version": {
      "$ref": "common.schema.json#/$defs/stateVersion"
    }
  }
}
