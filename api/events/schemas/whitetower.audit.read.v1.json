{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit log read",
  "description": "The audit log was queried or an audit event was read (AUD-09, ST-12).",
  "type": "object",
  "required": [
    "actor",
    "operation"
  ],
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "operation": {
      "type": "string",
      "enum": [
        "query",
        "get",
        "checkpoints",
        "keys"
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "agent_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "actor_id": {
          "type": "string",
          "maxLength": 128
        },
        "actor_type": {
          "type": "string",
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "maxLength": 128
        },
        "outcome": {
          "type": "string",
          "maxLength": 64
        },
        "source": {
          "type": "string",
          "maxLength": 512
        },
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "results_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
