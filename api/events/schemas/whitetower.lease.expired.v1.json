{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lease expired",
  "description": "What the instance did when an agent's lease expired (sections 5.3 and 5.8): one event per agent, with that agent as subject.",
  "type": "object",
  "required": [
    "lease_ttl_ms",
    "effect"
  ],
  "additionalProperties": false,
  "properties": {
    "lease_ttl_ms": {
      "type": "integer",
      "minimum": 10000,
      "maximum": 300000
    },
    "effect": {
      "enum": [
        "gate_closed",
        "quarantines_kept",
        "all_quarantined"
      ]
    }
  }
}
