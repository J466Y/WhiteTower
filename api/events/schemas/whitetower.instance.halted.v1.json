{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Instance halted",
  "description": "What a halt achieved at one enforcement point (section 5.5).",
  "type": "object",
  "required": [
    "halt_id",
    "halt_mode",
    "layers"
  ],
  "additionalProperties": false,
  "properties": {
    "halt_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "scope": {
      "description": "The halt's scope. Left out when the instance does not know it (section 5.5, EP-10).",
      "$ref": "common.schema.json#/$defs/haltScope"
    },
    "halt_mode": {
      "$ref": "common.schema.json#/$defs/haltMode"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/haltLayerReport"
      }
    }
  }
}
