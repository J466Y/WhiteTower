{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bundle activated",
  "description": "A bundle passed verification (section 7.4) and is active.",
  "type": "object",
  "required": [
    "version",
    "manifest_sha256",
    "policies"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "manifest_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "policies": {
      "description": "Number of policies in the bundle.",
      "type": "integer",
      "minimum": 0
    },
    "previous_version": {
      "type": "integer",
      "minimum": 0
    }
  }
}
