{
  "description": "YAML documents, and what MAN-1 makes of them (docs/contracts/module-contract-v0.1.md, sections 1 and 3.1): refused, or accepted with their canonical JSON. Generated by the tests of test/conformance/manifest.",
  "documents": [
    {
      "name": "not YAML",
      "yaml": "a: [b",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "no document",
      "yaml": "# a comment",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "two documents",
      "yaml": "a: 1\n---\nb: 2",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "an anchor",
      "yaml": "a: &x 1",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "an alias",
      "yaml": "a: &x 1\nb: *x",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a named tag",
      "yaml": "a: !!str 1",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a local tag",
      "yaml": "a: !port 1",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "the non-specific tag",
      "yaml": "a: ! 1",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a tag on a key",
      "yaml": "!x a: b",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a tag on a mapping",
      "yaml": "a: !\n  b: c",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a tag in a sequence",
      "yaml": "- ! a",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a tag after a byte order mark",
      "yaml": "\ufeffa: ! 1",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a tag after a character of two bytes",
      "yaml": "a: '\u00e9'\nb: ! c",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a tag after a YAML 1.1 line break",
      "yaml": "x: 1\n\u2028a: ! 5",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a merge key",
      "yaml": "a: {b: 1}\n<<: {c: 2}",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a duplicate key",
      "yaml": "a: 1\na: 2",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a duplicate key, once quoted",
      "yaml": "a: 1\n\"a\": 2",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a number as a key",
      "yaml": "1: a",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a boolean as a key",
      "yaml": "true: a",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a sequence as a key",
      "yaml": "? [a]\n: b",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "yes",
      "yaml": "a: yes",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "no",
      "yaml": "a: no",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "on",
      "yaml": "a: on",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "off",
      "yaml": "a: off",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "y",
      "yaml": "a: y",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "n",
      "yaml": "a: n",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "True",
      "yaml": "a: True",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "NULL",
      "yaml": "a: NULL",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a tilde",
      "yaml": "a: ~",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "an empty value",
      "yaml": "a:",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a YAML 1.1 octal",
      "yaml": "a: 0755",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a YAML 1.2 octal",
      "yaml": "a: 0o755",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a hexadecimal",
      "yaml": "a: 0x1F",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a binary",
      "yaml": "a: 0b101",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a sexagesimal",
      "yaml": "a: 1:30",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "underscores",
      "yaml": "a: 1_000",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "an exponent",
      "yaml": "a: 1e3",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a signed exponent",
      "yaml": "a: 1.5e+3",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a plus sign",
      "yaml": "a: +5",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a fraction without an integer part",
      "yaml": "a: .5",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a point without a fraction",
      "yaml": "a: 1.",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "infinity",
      "yaml": "a: .inf",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "not a number",
      "yaml": "a: .nan",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a date",
      "yaml": "a: 2026-10-28",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a time",
      "yaml": "a: 2026-10-28T10:15:02Z",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a time with spaces",
      "yaml": "a: 2026-10-28 10:15:02 -5",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "the value key",
      "yaml": "a: =",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "2^53",
      "yaml": "a: 9007199254740992",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "-2^53",
      "yaml": "a: -9007199254740992",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a fraction more precise than a double",
      "yaml": "a: 0.10000000000000001",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a fraction beyond a double",
      "yaml": "a: .5",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a noncharacter",
      "yaml": "a: \"\\uFFFF\"",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a noncharacter of the Arabic block",
      "yaml": "a: \"\\uFDD0\"",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "the last noncharacter",
      "yaml": "a: \"\\U0010FFFF\"",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "a lone surrogate",
      "yaml": "a: \"\\uD800\"",
      "expected": {
        "outcome": "refused"
      }
    },
    {
      "name": "literals",
      "yaml": "a: true\nb: false\nc: null",
      "expected": {
        "outcome": "accepted",
        "canonical_json": "{\"a\":true,\"b\":false,\"c\":null}"
      }
    },
    {
      "name": "integers",
      "yaml": "a: 0\nb: -5\nc: -0\nd: 9007199254740991\ne: -9007199254740991",
      "expected": {
        "outcome": "accepted",
        "canonical_json": "{\"a\":0,\"b\":-5,\"c\":0,\"d\":9007199254740991,\"e\":-9007199254740991}"
      }
    },
    {
      "name": "fractions",
      "yaml": "a: 1.5\nb: 1.0\nc: 0.1\nd: 0.000001\ne: 0.0000001\nf: -0.25",
      "expected": {
        "outcome": "accepted",
        "canonical_json": "{\"a\":1.5,\"b\":1,\"c\":0.1,\"d\":0.000001,\"e\":1e-7,\"f\":-0.25}"
      }
    },
    {
      "name": "quoted scalars",
      "yaml": "a: \"yes\"\nb: 'on'\nc: \"2026-10-28\"\nd: '1e3'\ne: \"~\"\nf: '0755'\ng: \"<<\"",
      "expected": {
        "outcome": "accepted",
        "canonical_json": "{\"a\":\"yes\",\"b\":\"on\",\"c\":\"2026-10-28\",\"d\":\"1e3\",\"e\":\"~\",\"f\":\"0755\",\"g\":\"<<\"}"
      }
    },
    {
      "name": "a quoted merge key",
      "yaml": "\"<<\": a",
      "expected": {
        "outcome": "accepted",
        "canonical_json": "{\"<<\":\"a\"}"
      }
    },
    {
      "name": "plain strings",
      "yaml": "a: 0.1.0\nb: v1alpha1\nc: Apache-2.0\nd: https://example.org/x\ne: inf\nf: 0x",
      "expected": {
        "outcome": "accepted",
        "canonical_json": "{\"a\":\"0.1.0\",\"b\":\"v1alpha1\",\"c\":\"Apache-2.0\",\"d\":\"https://example.org/x\",\"e\":\"inf\",\"f\":\"0x\"}"
      }
    },
    {
      "name": "block scalars",
      "yaml": "a: |\n  x\n  y\nb: >-\n  x\n  y\n",
      "expected": {
        "outcome": "accepted",
        "canonical_json": "{\"a\":\"x\\ny\\n\",\"b\":\"x y\"}"
      }
    },
    {
      "name": "a multi-line plain scalar",
      "yaml": "a: x\n  y",
      "expected": {
        "outcome": "accepted",
        "canonical_json": "{\"a\":\"x y\"}"
      }
    },
    {
      "name": "flow collections",
      "yaml": "a: {b: [x, 1], c: {}}",
      "expected": {
        "outcome": "accepted",
        "canonical_json": "{\"a\":{\"b\":[\"x\",1],\"c\":{}}}"
      }
    },
    {
      "name": "escapes",
      "yaml": "a: \"\\t\\u0007\\\\\\\"/\"",
      "expected": {
        "outcome": "accepted",
        "canonical_json": "{\"a\":\"\\t\\u0007\\\\\\\"/\"}"
      }
    },
    {
      "name": "keys in the order of UTF-16",
      "yaml": "\uff61: 1\n\ud83d\ude00: 2\nb: 3\na: 4",
      "expected": {
        "outcome": "accepted",
        "canonical_json": "{\"a\":4,\"b\":3,\"\ud83d\ude00\":2,\"\uff61\":1}"
      }
    },
    {
      "name": "a byte order mark and document markers",
      "yaml": "\ufeff---\na: 1\n...\n",
      "expected": {
        "outcome": "accepted",
        "canonical_json": "{\"a\":1}"
      }
    }
  ]
}
