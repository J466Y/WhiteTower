{"apiVersion":"whitetower/v1alpha1","kind":"ModuleManifest","metadata":{"description":"Isolates a halted agent's pods at the network level through the deny rules of the cluster's CNI, independently of the agent's process.","displayName":"Kubernetes network quarantine","homepage":"https://github.com/J466Y/WhiteTower","license":"Apache-2.0","name":"k8s-quarantine","vendor":"White Tower project","version":"0.1.0"},"spec":{"agents":"all","capabilities":[{"haltLayers":["network_quarantined"],"name":"runtime-control","platforms":["kubernetes"]}],"configSchema":{"additionalProperties":false,"properties":{"cluster":{"description":"Name of the cluster, shown in the console and in events.","type":"string"},"cni":{"enum":["cilium","calico","antrea","admin-network-policy"]},"coreEgress":{"additionalProperties":false,"description":"How quarantine rules let pods reach the core.","properties":{"cidrs":{"items":{"type":"string"},"type":"array"},"podSelector":{"additionalProperties":{"type":"string"},"type":"object"}},"type":"object"},"coreUrl":{"pattern":"^https://","type":"string"},"quarantineOnLeaseExpiry":{"default":false,"description":"Quarantine every covered agent when the module loses contact with the core (contract, section 5.8).","type":"boolean"}},"required":["coreUrl","cluster","cni"],"type":"object"},"contractVersions":["v1alpha1"],"events":{"consumes":[],"emits":["whitetower.instance.started.v1","whitetower.quarantine.applied.v1","whitetower.quarantine.lifted.v1","whitetower.lease.expired.v1"]},"identity":"module","permissions":["governance.watch","governance.acknowledge","events.publish"]}}