{
  "realm": "whitetower",
  "displayName": "White Tower (development)",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "groups": [
    { "name": "wt-steering" },
    { "name": "wt-advisory" },
    { "name": "wt-owners" },
    { "name": "wt-users" },
    { "name": "wt-operators" },
    { "name": "wt-auditors" },
    { "name": "wt-admins" }
  ],
  "clients": [
    {
      "clientId": "whitetower-console",
      "name": "White Tower console (backend-for-frontend)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "whitetower-console-dev-only",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://localhost:8443/auth/callback",
        "https://127.0.0.1:8443/auth/callback",
        "http://localhost:5173/auth/callback"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:8443/##https://127.0.0.1:8443/##http://localhost:5173/"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "wtctl",
      "name": "White Tower CLI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://127.0.0.1/*", "http://localhost/*"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
