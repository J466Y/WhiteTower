{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WhiteTowerValues",
  "description": "Configuration schema for the White Tower Helm chart",
  "type": "object",
  "required": [
    "replicaCount",
    "image",
    "serviceAccount",
    "podSecurityContext",
    "securityContext",
    "podDisruptionBudget",
    "service",
    "networkPolicy",
    "database",
    "audit"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 2,
      "description": "Number of core replicas for high availability (minimum 2)"
    },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "required": ["create"],
      "properties": {
        "create": { "type": "boolean" },
        "automountServiceAccountToken": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "required": ["runAsNonRoot", "runAsUser", "runAsGroup", "fsGroup", "seccompProfile"],
      "properties": {
        "runAsNonRoot": { "type": "boolean", "const": true },
        "runAsUser": { "type": "integer" },
        "runAsGroup": { "type": "integer" },
        "fsGroup": { "type": "integer" },
        "seccompProfile": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["RuntimeDefault", "Localhost"] }
          }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities"],
      "properties": {
        "allowPrivilegeEscalation": { "type": "boolean", "const": false },
        "readOnlyRootFilesystem": { "type": "boolean", "const": true },
        "capabilities": {
          "type": "object",
          "required": ["drop"],
          "properties": {
            "drop": {
              "type": "array",
              "items": { "type": "string" },
              "contains": { "const": "ALL" }
            }
          }
        }
      }
    },
    "strategy": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["RollingUpdate", "Recreate"] },
        "rollingUpdate": {
          "type": "object",
          "properties": {
            "maxSurge": { "type": ["integer", "string"] },
            "maxUnavailable": { "type": ["integer", "string"] }
          }
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 60,
      "description": "Must be greater than 60s drain deadline"
    },
    "affinity": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "service": {
      "type": "object",
      "required": ["console", "machine", "operations"],
      "properties": {
        "console": {
          "type": "object",
          "required": ["type", "port"],
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer" },
            "annotations": { "type": "object" }
          }
        },
        "machine": {
          "type": "object",
          "required": ["type", "port"],
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer" },
            "annotations": { "type": "object" }
          }
        },
        "operations": {
          "type": "object",
          "required": ["type", "port"],
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort"] },
            "port": { "type": "integer" },
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "console": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": { "type": "object" },
            "hosts": { "type": "array" },
            "tls": { "type": "array" }
          }
        },
        "machine": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": { "type": "object" },
            "hosts": { "type": "array" },
            "tls": { "type": "array" }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": { "type": "object" },
        "requests": { "type": "object" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingress", "egress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": {
          "type": "object",
          "required": ["console", "machine", "operations"],
          "properties": {
            "console": { "type": "object" },
            "machine": { "type": "object" },
            "operations": { "type": "object" }
          }
        },
        "egress": {
          "type": "object",
          "required": ["dns", "database"],
          "properties": {
            "dns": { "type": "object" },
            "database": { "type": "object" },
            "custom": { "type": "array" }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "labels": { "type": "object" }
      }
    },
    "database": {
      "type": "object",
      "required": ["url", "migrationUrl", "maxConnections"],
      "properties": {
        "url": { "type": "string" },
        "migrationUrl": { "type": "string" },
        "maxConnections": { "type": "integer", "minimum": 1 }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "databaseApp": { "type": "object" },
        "databaseMigrator": { "type": "object" },
        "auditCheckpointKey": { "type": "object" },
        "tokenSigningKey": { "type": "object" },
        "bundleSigningKey": { "type": "object" },
        "oidcClientSecret": { "type": "object" }
      }
    },
    "audit": {
      "type": "object",
      "required": ["origin", "checkpointInterval"],
      "properties": {
        "origin": { "type": "string" },
        "checkpointInterval": { "type": "string" }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": { "type": "string" },
            "clientId": { "type": "string" },
            "redirectUrl": { "type": "string" }
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "console": { "type": "object" },
        "machine": { "type": "object" }
      }
    },
    "dev": {
      "type": "object",
      "properties": {
        "selfSignedTls": { "type": "boolean" }
      }
    }
  }
}
